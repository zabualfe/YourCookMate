# Optional — OAuth client IDs (must match backend GOOGLE_CLIENT_ID / APPLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
# Web Services ID — must match backend APPLE_CLIENT_ID
VITE_APPLE_CLIENT_ID=

# Production API URL (required on Vercel). Leave unset locally — Vite proxies /api to localhost:8000.
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/prod
VITE_API_URL=

# Optional — same as VITE_API_URL when using a single AWS API. Used for async ingest/parse routing.
VITE_AWS_API_URL=

# Same URL — server-only alias works on Vercel without a frontend rebuild
AWS_API_URL=

# AdSense — ads show for guests and free users only. Optional slot IDs from AdSense → Ads → By ad unit.
# VITE_ADSENSE_SLOT_BANNER=
# VITE_ADSENSE_SLOT_INFEED=
# VITE_ADSENSE_SLOT_COOK=

# Feature flags — live toggles at https://your-site/admin (Supabase). Env vars below are optional fallbacks.
# FEATURE_AUTH=true
# FEATURE_REGISTRATION=true
# FEATURE_AI=true
# FEATURE_SOCIAL_INGEST=true
# FEATURE_COMMUNITY=true
# FEATURE_INSTACART=true
