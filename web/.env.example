# Optional — OAuth client IDs (must match backend GOOGLE_CLIENT_ID / APPLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# Production API URL (required on Vercel). Leave unset locally — Vite proxies /api to localhost:8000.
# Example: https://yourcookmate-api.onrender.com
VITE_API_URL=

# AWS API Gateway URL for async video ingest (optional). When set, Import from link uses SQS on AWS.
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/prod
VITE_AWS_API_URL=

# Feature flags — live toggles at https://your-site/admin (Supabase). Env vars below are optional fallbacks.
# FEATURE_AUTH=true
# FEATURE_REGISTRATION=true
# FEATURE_AI=true
# FEATURE_SOCIAL_INGEST=true
# FEATURE_COMMUNITY=true
# FEATURE_INSTACART=true
