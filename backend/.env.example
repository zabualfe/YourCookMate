OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
# Local AI: auto prefers Bedrock when AWS creds exist, else OpenAI.
# AI_PROVIDER=bedrock|openai|auto
AI_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_PARSE_MODEL=amazon.nova-pro-v1:0
BEDROCK_VISION_MODEL=amazon.nova-pro-v1:0
# Gemini native video (preferred for TikTok/Reels when set). API key OR Vertex project+ADC.
# GEMINI_API_KEY=
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=./allchat.json
# VERTEX_LOCATION=us-central1
# GEMINI_VISION_MODEL=gemini-3.5-flash
# SOCIAL_VISION_PROVIDER=auto|gemini|frames
# Vision quality (frame fallback only): balanced | accurate | fast
# SOCIAL_VISION_QUALITY=balanced
# Optional fine-grained overrides (usually leave unset — quality preset wins):
# SOCIAL_FRAME_SAMPLE_FPS=1
# SOCIAL_STEP_MAX_FRAMES=60
# SOCIAL_VISION_MAX_FRAMES=24
# SOCIAL_SCENE_THRESHOLD=0.28
# Multi-agent video analysis (segment + OCR + ingredients + actions). Set false for single-pass.
# SOCIAL_VISION_MULTI_AGENT=true
# SOCIAL_VISION_MAX_WORKERS=4
# SOCIAL_VISION_SEGMENT_FRAMES=6
# SOCIAL_VISION_MAX_SEGMENTS=6
# Step video timestamps: none (default, off) | deterministic (frame clock, no LLM) | ai
# SOCIAL_TIMESTAMP_MODE=none
# Speech-to-text: auto (AWS when INGEST_TEMP_BUCKET + creds, else OpenAI Whisper), aws, openai.
TRANSCRIBE_PROVIDER=auto
# "auto" lets Amazon Transcribe identify the language; or set a code like en-US.
TRANSCRIBE_LANGUAGE=auto
# Required for Amazon Transcribe: an S3 bucket for temporary audio uploads.
# INGEST_TEMP_BUCKET=your-transcribe-temp-bucket
# Comma-separated browser origins. FRONTEND_URL is always allowed automatically.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local dev (default):
# DATABASE_URL=sqlite:///./yourcookmate.db
#
# Supabase (Project Settings → Database → Connect → Session pooler, port 5432):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-us-east-2.pooler.supabase.com:5432/postgres
# Use Session pooler (port 5432), not Transaction pooler (6543), for SQLAlchemy.
DATABASE_URL=sqlite:///./yourcookmate.db

# Public API URL (Render/Railway/etc.) — used in emails, OAuth callbacks, upload URLs
API_BASE_URL=http://127.0.0.1:8000
JWT_SECRET=dev-change-me-in-production

# Optional OAuth (leave blank to hide buttons in the UI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
APPLE_CLIENT_ID=
# iOS app bundle ID (com.yourcookmate.app) — audience for native Sign in with Apple tokens
APPLE_IOS_CLIENT_ID=

# Frontend URL (used in verification email links)
FRONTEND_URL=http://localhost:5173

# Instacart — set INSTACART_ENABLED=true after you have Developer Platform access
# Apply: https://instacart.com/company/business/developers
INSTACART_ENABLED=false

# Comma-separated admin emails allowed to access /admin
ADMIN_EMAILS=zabualfe@gmail.com

# Feature flags — prefer live toggles at /admin (Supabase). Env vars are fallbacks when DB is empty.
# FEATURE_AUTH=true
# FEATURE_REGISTRATION=true
# FEATURE_AI=true
# FEATURE_SOCIAL_INGEST=true
# FEATURE_COMMUNITY=true
# FEATURE_INSTACART=true
# Opt-in Amazon Transcribe (also toggleable at /admin). Requires INGEST_TEMP_BUCKET.
# FEATURE_AWS_TRANSCRIBE=false
INSTACART_API_KEY=
INSTACART_API_BASE=https://connect.dev.instacart.tools
INSTACART_LINK_EXPIRES_DAYS=30

# Instacart Connect OAuth (account linking — separate Instacart Connect partner program)
INSTACART_CONNECT_CLIENT_ID=
INSTACART_CONNECT_CLIENT_SECRET=
INSTACART_CONNECT_API_BASE=https://connect.dev.instacart.tools
# Authorization URL provided by Instacart when account_linking scope is enabled
INSTACART_CONNECT_AUTHORIZE_URL=

# Resend (recommended): https://resend.com/api-keys
# Production (Render): use AWS API Gateway instead — Resend key lives on the email Lambda only.
# RESEND_API_KEY=
# AWS_API_URL=https://YOUR_API.execute-api.us-east-1.amazonaws.com/prod
# EMAIL_API_URL=https://YOUR_API.execute-api.us-east-1.amazonaws.com/prod
# EMAIL_API_SECRET=generate-a-long-random-string

# Optional — Instagram/Facebook import from cloud servers (Render blocks without login cookies).
# Local file path:
# YTDLP_COOKIES_FILE=./cookies.txt
# Or paste Netscape-format cookie file contents (useful on Render as a secret env var):
# YTDLP_COOKIES=
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_FROM=noreply@yourcookmate.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true
