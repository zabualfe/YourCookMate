{
  "name": "your-cook-mate",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "db:up": "docker compose up -d postgres",
    "db:init": "node scripts/init-db.js",
    "test:smtp": "node scripts/test-smtp.js",
    "dev": "node scripts/ensure-db.js && concurrently -n backend,web,stripe -c green,cyan,magenta \"node scripts/run-backend.js\" \"npm run dev --prefix web\" \"node scripts/run-stripe-listen.js\"",
    "dev:stripe": "node scripts/run-stripe-listen.js",
    "db:check": "node scripts/ensure-db.js",
    "dev:backend": "node scripts/run-backend.js",
    "dev:web": "npm run dev --prefix web",
    "dev:mobile": "npm run start --prefix mobile",
    "ios": "npm run ios --prefix mobile",
    "export:cookies": "bash scripts/export-ytdlp-cookies.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
